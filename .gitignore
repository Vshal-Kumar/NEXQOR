# ── QRYPTONEX Global .gitignore ──────────────────────────────────────

# Compiled executable binaries
**/server
**/server_rx
**/server_tx
**/client
**/client_broadcast
!**/src/**
**/bench_pqc
**/benchpqc
bench_pqc
benchpqc
**/bench_crypto
**/bench_hybrid
**/bench_nclient
**/bench_aead

# Embedded ARM binaries
**/*_arm
**/*_arm64
**/*_arm32

# Test and example binaries (keep source files)
**/tests/test_*
!**/tests/test_*.c
**/tests/test_suite
!**/tests/test_suite.c
**/examples/hybrid_client
**/examples/hybrid_server

# Object and library files
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll

# Build and local directories
build/
bin/
liboqs/build/
liboqs/build_x86_64/
liboqs/build_arm64/
liboqs/build_arm32/

# ESP32 / Arduino / PlatformIO firmware build artifacts
esp32/**/.pio/
esp32/**/.vscode/
esp32/**/build/
*.bin
*.elf
*.hex

# Debian packaging staging and intermediate objects
securecomm/packaging/debian/obj_*/
securecomm/packaging/debian/staging/

# Cryptographic private keys and runtime artifacts
*.key
*.pub
*.db
server_endpoint.info
**/server_endpoint.info

# Logs and runtime dumps
*.log
core
core.*

# GTK 4 Dashboards & Security Testing Engine
ui/qhack_ui
security_lab/ui/attack_ui
security_lab/security_lab
security_lab/tests/test_safety
security_lab/tests/test_packet_parser
security_lab/tests/test_metrics

# Security Lab Run Results and Evidence Artifacts
security_lab/results/run_*
security_lab/results/latest
security_lab/results/*.log
security_lab/results/*.csv
security_lab/results/*.json
security_lab/results/*.md
!security_lab/results/.gitkeep

# UNIX Domain IPC Sockets & Runtime Temporary Files
*.sock
/tmp/*_rx.sock
/tmp/*_tx.sock
/tmp/qhack_*
/tmp/securecomm_*

# Editor, OS, and IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


