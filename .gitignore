# ── QRYPTONEX Global .gitignore ──────────────────────────────────────

# Compiled executable binaries
**/server
**/server_rx
**/server_tx
**/client
**/client_broadcast
**/bench_pqc
**/benchpqc
bench_pqc
benchpqc
**/bench_crypto
**/bench_hybrid
**/bench_nclient
**/bench_aead

# Embedded ARM binaries
**/*_arm
**/*_arm64
**/*_arm32

# Test and example binaries (keep source files)
**/tests/test_*
!**/tests/test_*.c
**/tests/test_suite
!**/tests/test_suite.c
**/examples/hybrid_client
**/examples/hybrid_server

# Object and library files
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll

# Build and local directories
build/
bin/
liboqs/build/
liboqs/build_x86_64/
liboqs/build_arm64/
liboqs/build_arm32/

# Cryptographic private keys and runtime artifacts
*.key
*.pub
*.db
server_endpoint.info
**/server_endpoint.info

# Logs and runtime dumps
*.log
core
core.*

# Editor and IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
